[Unit]
Description=CAPTCHA Bridge (Docker)
After=brave-cdp.service
Requires=brave-cdp.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/docker/captcha-solver
ExecStart=/usr/bin/docker compose up -d --build captcha-bridge
ExecStop=/usr/bin/docker compose down captcha-bridge

[Install]
WantedBy=default.target
