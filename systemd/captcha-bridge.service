[Unit]
Description=CAPTCHA Bridge (Docker)
After=brave-cdp.service
Requires=brave-cdp.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose -f %h/docker/captcha-solver/docker-compose.yml up -d --build captcha-bridge
ExecStop=/usr/bin/docker compose -f %h/docker/captcha-solver/docker-compose.yml down captcha-bridge

[Install]
WantedBy=default.target
